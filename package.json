{
  "name": "@dan-slater/map-kit",
  "version": "0.1.1",
  "description": "Svelte 5 components over MapLibre GL JS and OpenFreeMap vector tiles: globe map, pins, panel, toggle layers, and a canvas overlay registered to map coordinates.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dan-slater/map-kit.git"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "files": [
    "dist",
    "src/lib"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-package -i src/lib -o dist",
    "check:dist": "svelte-package -i src/lib -o dist && git diff --exit-code -- dist",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test",
    "demo:build": "vite build"
  },
  "peerDependencies": {
    "maplibre-gl": "^5",
    "svelte": "^5"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.2",
    "@types/geojson": "^7946.0.16",
    "@webgpu/types": "^0.1.74",
    "maplibre-gl": "^5.9.0",
    "playwright": "^1.64.0",
    "publint": "^0.3.14",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
