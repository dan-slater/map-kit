{
  "name": "@dan-slater/map-kit",
  "version": "0.1.0",
  "description": "Svelte 5 components over MapLibre GL JS and OpenFreeMap vector tiles: globe map, pins, panel, toggle layers, and a canvas overlay registered to map coordinates.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dan-slater/map-kit.git"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/lib"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-package -i src/lib -o dist",
    "prepare": "svelte-package -i src/lib -o dist",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "demo:build": "vite build"
  },
  "peerDependencies": {
    "maplibre-gl": "^5",
    "svelte": "^5"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.46.4",
    "@sveltejs/package": "^2.5.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/geojson": "^7946.0.16",
    "maplibre-gl": "^5.9.0",
    "publint": "^0.3.14",
    "svelte": "^5.42.2",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
