{
	"extends": "$app/tsconfig",
	"include": ["src", "tests", "*"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		// SvelteKit 3 no longer writes .svelte-kit/tsconfig.json, so the extra
		// type packages have to be named here. The #lib specifier the demo
		// uses comes from the package.json "imports" field, which SvelteKit
		// turns into tsconfig paths during sync.
		// $app/tsconfig pins `types`, which switches off automatic @types
		// discovery, so bun:test has to be named explicitly.
		"types": ["$app/types", "bun"],
		"strict": true,
		"sourceMap": true
	}
}
